{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'config:best-practices',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':rebaseStalePrs',
  ],
  'internalChecksFilter': 'strict',
  'minimumReleaseAge': '7 days',
  'branchPrefix': 'renovate/',
  // You can build the email with this info: curl -s https://api.github.com/users/odgbot%5Bbot%5D | grep -E '"id"|"login"' — format: <id>+<slug>[bot]@users.noreply.github.com
  'gitAuthor': 'odgbot[bot] <319464553+odgbot[bot]@users.noreply.github.com>',
  'gitIgnoredAuthors': [
    '319464553+odgbot[bot]@users.noreply.github.com',
  ],
  // drip-feed PRs (0 = unlimited) so the initial onboarding wave after
  // enabling renovate on this repo doesn't flood reviewers; renovate
  // opens more as PRs get merged
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  automerge: false,
  automergeType: 'pr',
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
    automerge: false,
  },
  packageRules: [
    {
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
    {
      matchManagers: ['github-actions'],
      automerge: true,
    },
    {
      // gardener/cc-utils is intentionally pinned to @v1 as a floating major
      // tag — frequent updates, deliberately unpinned. Disable to avoid
      // constant SHA-bump PRs.
      matchManagers: ['github-actions'],
      matchDepNames: ['gardener/cc-utils'],
      enabled: false,
    },
    // --- Major-update holds (dependency-dashboard triage, see issue #486) ---
    // These majors must not be merged blindly: this repo has no automated
    // tests, so each needs a tracked migration instead of a renovate PR.
    {
      // HOLD eslint 10: blocked upstream — eslint-plugin-jsx-a11y (v6.10.2)
      // caps eslint at ^9 and appears abandoned since 2024-10; additionally
      // eslint-plugin-react (v7.37.5) caps at ^9.7. Do not force the update
      // (--legacy-peer-deps would silently break .ci/lint); re-enable once
      // both plugins declare eslint 10 support.
      matchDepNames: ['eslint'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // HOLD react/react-dom 19: blocked by deprecated react-beautiful-dnd
      // (used in src/landing.js and src/util/versionOverview.js) — the DnD
      // library must be replaced first. Tracked in issue #289
      // ("Migrate to React 19").
      matchDepNames: ['react', 'react-dom'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // HOLD react-router 8: its peer deps require react >= 19.2.7, so it is
      // transitively blocked by the React 19 migration (issue #289) and
      // cannot be merged independently.
      matchDepNames: ['react-router', 'react-router-dom'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // HOLD @mui/* 9: this repo is 2-4 majors behind (core 5→9, x-* 7→9)
      // with ~188 import sites across 40 files and no automated tests, so
      // the upgrade needs a dedicated migration (MUI codemods + manual
      // click-through of the UI) rather than a renovate PR. Tracked in a
      // dedicated migration ticket.
      matchDepNames: [
        '@mui/material',
        '@mui/icons-material',
        '@mui/x-charts',
        '@mui/x-data-grid',
        '@mui/x-date-pickers',
      ],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
  postUpgradeTasks: {
    commands: [
      // sync the `version:` of resources in .ocm/base-component.yaml with the
      // imageReference updated by the customManager below (e.g. busybox)
      'python3 .ci/renovate-sync-ocm',
    ],
    fileFilters: ['.ocm/base-component.yaml'],
    executionMode: 'branch',
  },
  customManagers: [
    {
      // Track the Renovate version used in the workflow
      customType: 'regex',
      managerFilePatterns: ['.github/workflows/renovate.yml'],
      matchStrings: ["renovate-version:\\s*'(?<currentValue>[^'@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'"],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: ['.ocm/base-component.yaml'],
      matchStrings: [
        'imageReference:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?'
      ],
      datasourceTemplate: 'docker',
    },
  ],
}
