#!/usr/bin/env python3

import os
import re
import subprocess


own_dir = os.path.dirname(__file__)
repo_dir = os.path.abspath(os.path.join(own_dir, os.pardir))
BASE_COMPONENT_FILE = os.path.join(repo_dir, '.ocm', 'base-component.yaml')


def image_reference_changed():
    try:
        result = subprocess.run(
            ['git', 'diff', '--', BASE_COMPONENT_FILE],
            capture_output=True, text=True, check=True,
            cwd=repo_dir,
        )
        for line in result.stdout.splitlines():
            if line.startswith(('+', '-')) and not line.startswith(('+++', '---')):
                if 'imageReference:' in line:
                    return True
        return False
    except (subprocess.CalledProcessError, FileNotFoundError):
        return True


def derive_version(image_reference):
    ref = image_reference.split('@')[0]
    return ref.rsplit(':', 1)[-1]


def sync_block(block):
    '''Sets the block's `version:` to the tag of its `imageReference:`.

    A block is one entry of the `resources:` list. The two attributes may
    appear in either order within the block, so index-based patching is used.
    Line-based editing is deliberate: PyYAML is not available in the renovate
    container, and a yaml round-trip would reformat the whole file.
    '''
    version_idx = None
    version = None

    for idx, line in enumerate(block):
        if version_idx is None and re.match(r'^\s*version:\s*.+$', line):
            version_idx = idx
            continue

        match = re.match(r'^\s*imageReference:\s*(.+)$', line)
        if match:
            version = derive_version(match.group(1).strip())

    if version_idx is not None and version is not None:
        indent = re.match(r'^(\s*)', block[version_idx]).group(1)
        block[version_idx] = f'{indent}version: {version}\n'

    return block


def update_base_component(filepath):
    with open(filepath) as f:
        lines = f.readlines()

    result = []
    block = []

    for line in lines:
        # resource entries are direct children of `resources:` (two-space indent)
        if line.startswith('  - '):
            result.extend(sync_block(block))
            block = []
        block.append(line)
    result.extend(sync_block(block))

    with open(filepath, 'w') as f:
        f.writelines(result)


def main():
    if not image_reference_changed():
        return
    update_base_component(BASE_COMPONENT_FILE)


if __name__ == '__main__':
    main()
